# Copie para .env (fica fora do git). Alternativa às variáveis: tns.json ao lado do programa.
# Bot do Transient Name Server: https://www.wis-tns.org/bots/edit
TNS_BOT_ID=12345
TNS_BOT_NAME=your_bot_name
TNS_API_KEY=
# Opcional: avisos de falha das rodadas agendadas no Sentry
SENTRY_DSN=
# Opcional: pasta de saída (resultados, relatório, log); padrão = ao lado do programa
CACASN_SAIDA=
